# Copy to deploy/.env (gitignored) and fill in.
SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
# The public host name. Caddy gets its certificate from Let's Encrypt (ACME_EMAIL), and the EVE
# application's callback must be https://<DOMAIN>/callback. ACME_EMAIL is required.
DOMAIN=localhost
ACME_EMAIL=
# Optional: ":80" when another reverse proxy on the box terminates TLS. Empty: DOMAIN.
SITE_ADDRESS=
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
EVE_CALLBACK_URL=https://localhost/callback
ESI_CONTACT_EMAIL=
# Optional: a Fernet key (urlsafe base64, 32 bytes) for stored ESI tokens. Empty: derived
# from SECRET_KEY, so changing SECRET_KEY makes every character re-link.
TOKEN_ENCRYPTION_KEY=
