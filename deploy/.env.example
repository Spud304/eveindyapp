# Copy to deploy/.env (gitignored) and fill in.
SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
DOMAIN=localhost
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
EVE_CALLBACK_URL=
ESI_CONTACT_EMAIL=
# Optional: a Fernet key (urlsafe base64, 32 bytes) for stored ESI tokens. Empty: derived
# from SECRET_KEY, so changing SECRET_KEY makes every character re-link.
TOKEN_ENCRYPTION_KEY=
