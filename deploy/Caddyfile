{
	email {$ACME_EMAIL}
	servers {
		# Behind another reverse proxy (SITE_ADDRESS=:80) the X-Forwarded-* headers it sets must be
		# kept, or Django sees http and rejects the CSRF origin. Docker networks are private ranges.
		trusted_proxies static private_ranges
	}
}

# SITE_ADDRESS is the domain (Caddy gets the certificate) or :80 when another proxy terminates TLS.
{$SITE_ADDRESS} {
	encode zstd gzip

	# The same paths the Vite dev server proxies (frontend/vite.config.ts). /callback is EVE SSO's.
	@backend path /api/* /auth/* /callback /admin/* /static/*
	handle @backend {
		reverse_proxy web:8000
	}

	handle {
		root * /srv/dist
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
