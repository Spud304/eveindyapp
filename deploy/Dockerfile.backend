# Backend image for web, worker and scheduler. Adapted from the AT Tool's deploy/Dockerfile.backend.
FROM python:3.12-slim AS base
# The virtualenv lives outside /app, so the dev compose file can mount backend/ over /app.
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /uvx /bin/
# supercronic: cron for containers, logs to stdout, no daemon. SHA1 sums from the v0.2.33
# release page (as pinned in the AT Tool). Bump version and sums together.
ARG SUPERCRONIC_VERSION=v0.2.33
ARG TARGETARCH=amd64
RUN case "${TARGETARCH}" in \
      amd64) sum=71b0d58cc53f6bd72cf2f293e09e294b79c666d8 ;; \
      arm64) sum=e0f0c06ebc5627e43b25475711e694450489ab00 ;; \
      *) echo "no supercronic checksum for ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
 && curl -fsSL "https://github.com/aptible/supercronic/releases/download/${SUPERCRONIC_VERSION}/supercronic-linux-${TARGETARCH}" -o /usr/local/bin/supercronic \
 && echo "${sum}  /usr/local/bin/supercronic" | sha1sum -c - \
 && chmod +x /usr/local/bin/supercronic
WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY backend/ ./
COPY deploy/entrypoint.sh deploy/crontab /app/deploy/
RUN chmod +x /app/deploy/entrypoint.sh
ARG APP_VERSION=dev
ENV APP_VERSION=${APP_VERSION} PATH="/opt/venv/bin:$PATH"
EXPOSE 8000
